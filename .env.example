# Copy to .env and change the secrets before using outside a laptop.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=solarerp
MYSQL_USER=solarerp
MYSQL_PASSWORD=change-me
# Host port for MySQL (3307 avoids clashing with a local MySQL on 3306)
MYSQL_HOST_PORT=3307

MINIO_ROOT_USER=solarerp
MINIO_ROOT_PASSWORD=change-me-minio

API_PORT=3000
WEB_PORT=8080
LOG_LEVEL=info
